# Filled in automatically by `npm run db:env` from your running local Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Leave empty in local dev (Vite proxies /api to localhost:8787).
# In production, set to your deployed scanner API, e.g. https://scanner.example.com
VITE_API_URL=

# Show the "Continue with Google" button (requires Google OAuth set up in supabase/config.toml)
VITE_ENABLE_GOOGLE=false
