# Filled in automatically by `npm run db:env` from your running local Supabase.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# API server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Monthly scan quotas per plan
FREE_MONTHLY_SCANS=100
PRO_MONTHLY_SCANS=2000
AGENCY_MONTHLY_SCANS=10000

# How many headless-browser scans can run at the same time on this machine
MAX_CONCURRENT_SCANS=2

# Set to true only if you need to scan sites on your own network (e.g. localhost dev sites).
ALLOW_PRIVATE_TARGETS=false
